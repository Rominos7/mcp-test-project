# ===========================================
# MCP Server Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# -------------------------------------------
# Server Configuration
# -------------------------------------------
NODE_ENV=production
MCP_PORT=3000

# -------------------------------------------
# Security Configuration
# -------------------------------------------
# API Key for authentication (CHANGE THIS!)
MCP_API_KEY=your-secret-api-key-here

# Allowed CORS origins (comma-separated)
# Use * wildcard for pattern matching
# Examples:
#   - http://localhost:*
#   - https://yourdomain.com
#   - https://*.yourdomain.com
ALLOWED_ORIGINS=http://localhost:*,https://yourdomain.com

# -------------------------------------------
# AI Configuration
# -------------------------------------------
# Anthropic API Key for AI summarization tool
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# -------------------------------------------
# Optional: Additional OpenAI Configuration
# (Currently not used, but available for future features)
# -------------------------------------------
# OPENAI_API_KEY=sk-...

# ===========================================
# Docker-Specific Configuration
# ===========================================
# When running in Docker, these are automatically set
# You can override them in docker-compose.yml

# Example production values:
# NODE_ENV=production
# MCP_PORT=3000
# MCP_API_KEY=super-secret-production-key
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# ===========================================
# HTTP Client Configuration
# ===========================================
# Configuration for the HTTP client (client-http.ts)

# MCP Server URL to connect to
# Examples:
#   - Local: http://localhost:3000/mcp
#   - Docker: http://mcp-server:3000/mcp
#   - Remote: https://your-server.com/mcp
MCP_SERVER_URL=http://localhost:3000/mcp

# API Key for authentication (must match server's MCP_API_KEY)
# MCP_API_KEY=development-key

# Note: When connecting to remote servers, use HTTPS for security!
